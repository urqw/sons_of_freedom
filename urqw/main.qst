end


:Эпилог
if count_7.11=1 or count_7.15=1 or count_7.13=1 or count_7.16=1 then end=1 else end=2
if count_7.11=1 or count_7.15=1 or count_7.13=1 or count_7.16=1 then pln Эпилог "Утопия" else pln Эпилог "Антиутопия"
if count_7.11=1 or count_7.15=1 or count_7.13=1 or count_7.16=1 then pln Другие, медленно но верно, шли к своей победе. Одна за другой, страны капитулировали, присоединяясь к империи, которая с каждым днём становилась всё мощнее. Через пять лет война окончилась. Не стало больше Других, потому как все люди земли были реморализованы. Жестокость, несправедливость, болезни, старость, всё осталось в прошлом. "Сыны Свободы" одержали свою последнюю победу. Мир стал таким, каким хотел видеть его Правитель. Миром, где восторжествовала справедливость. И, естественно, никому не было дела до эфемерной свободы, которой лишили всех и каждого из людей. else pln Никто не смог понять, что произошло. В один, ничем не примечательный день, "Сыны Свободы" вдруг перестали существовать. Через три месяца после этого война была окончена. Австралия и Китай капитулировали. Что случилось на самом деле - знали лишь единицы. Общественность никогда не узнала, кем был Егор Станенко, и какую цену он заплатил, чтобы закончилась война. Жизнь вернулась в прежнее русло.
btn Эпилог2, Далее
end

:Эпилог2
pln Послесловие
if andreev>4 then pln Андреев Евгений Олегович был расстрелян за предательство через два дня после моего побега. Стараниями особистов было выявлено, что он оказал мне помощь при побеге. 
if andreev<4 and end=1 then pln Андреев Евгений Олегович был убит через год, во время бомбардировки двести сорок второй военной базы китайскими ВВС. Те, кто его знал, говорили потом, что перед своей смертью он вспоминал Егора Станенко. Единственного человека, говорившего всю правду.
if andreev<4 and end=2 then pln Андреев Евгений Олегович продолжал нести службу ещё восемь лет. После чего ушёл в отставку, и остаток жизни дожил в тишине и покое, в доме на берегу озера. Он всё собирался написать книгу, свои воспоминания о войне, но так никогда и не написал её.
if count_5.24=1 then pln Аркадий Николаевич Попов, после своего чудесного спасения из лап монстра, подал в отставку и, к удивлению своей родни и знакомых, ушёл в монастырь. Остаток своей жизни он провёл, замаливая грехи, которые совершил.
if count_5.20=1 then pln Аркадий Николаевич Попов был арестован на следующий день после нашей с ним последней встречи. Как выяснилось, он действовал вопреки приказу, и задержание Анны Шаровой было признано неправомерным. Ане принесли извинения и отпустили домой. Впрочем, Попов не был наказан. Его пожурили, и освободили из-под стражи. Он продолжил нести службу и умер через год в своём кабинете от сердечного приступа.
if dd=0 then pln Димка Федюнин, после нашего последнего совместного вылета, уволился из армии и вернулся к мирной жизни. О войне он старался даже не разговаривать. else pln Дмитрий Федюнин, мой ведомый и хороший друг, погиб во время нашего совместного боевого вылета. Он похоронен в своём родном городе, и его могилу часто навещают родственники.
pln Александр Станенко, мой отец, говорят, очень быстро постарел, после того, как узнал все подробности произошедших со мной событий. Он остался жить в домике в тайге, и стал егерем. О том, что у него когда-то был сын он постарался забыть.
if antded=1 then pln Мой лучший друг Антон был погребён в нашем родном городе, на кладбище. Он похоронен рядом со своим отцом. 
if anded=1 then pln Аня, моя любимая Аня. Мы не успели даже нормально поговорить. Она умерла. Её тело увезли на историческую родину, в Санкт-Петербург. Где она была похоронена я не знаю. Да и не хочу знать, честно говоря. В моей памяти она до сих пор жива. И будет жить, пока жив я.
if antded=0 and anska=1 then pln Аня и Антон часто общались и хорошо знали друг друга. Естественно, когда я исчез, общение их не прекратилось. Через три года они поженились. У них двое детей. Старшего, сына, зовут Егор.
if anska=0 then pln Аня, моя любимая Аня. После того, как она была освобождена из лап Попова, она ждала меня. Каждый день она ждала, что я позвоню или постучу в дверь. Она верила, что мы снова встретимся.
if anska=0 and antded=0 then pln Антон часто видится с Аней, поддерживает её, но обо мне в её присутствии старается не вспоминать. Он уверен, что поступил правильно, когда поверил в меня. Он - мой единственный настоящий друг.
if anded=1 and antded=0 then pln Антон, когда узнал о смерти Ани, проклял меня. Он поклялся, что если встретит меня - я отвечу перед ним по всей строгости, за её смерть, больше никогда он не назвал имени Егора Станенко. Он, пока было возможно, оставался на военной службе, и всё мечтал расквитаться со мной.
pln
pln Что же касается меня...

if count_7.15=1 then pln Я стал Правителем Других. Я вёл своё государство вперёд, уверенно и целенаправленно. Убийца, зверь, уставший от войны и смерти, я вёл свою страну к миру. Я вёл свою страну к утопии. 
if count_7.15=1 and anska=0 then pln Когда закончилась война, я тайком покинул Храм и отыскал Аню. Спустя год она стала моей Правительницей. И это стало для меня наградой за все страдания, которые мне пришлось пережить.
if count_7.11=1 then pln Я стал генералом Других. Я вёл своё государство вперёд, уверенно и целенаправленно. Убийца, зверь, уставший от войны и смерти, я вёл свою страну к миру. Я вёл свою страну к утопии. 
if count_7.11=1 and anska=0 then pln Когда закончилась война, я тайком покинул Храм и отыскал Аню. Спустя год она стала моей женой. И это стало для меня наградой за все страдания, которые мне пришлось пережить.
if count_7.14=1 then pln Уничтожив "Сынов Свободы", я вернулся в Россию. По прибытии в страну я был арестован, и после скорого суда, где меня обвинили в полутора десятках преступлений, я оказался за решёткой. Мне дали четыре пожизненных срока в одиночке. Через год я сошёл с ума от одиночества и отчаяния и покончил с собой. Я даже не узнал, кончилась ли война.
if count_7.13=1 then pln Через три месяца я вернулся в Россию. По прибытии в страну я был арестован, и после скорого суда, где меня обвинили в полутора десятках преступлений, я оказался за решёткой. Мне дали четыре пожизненных срока в одиночке. Через год я сошёл с ума от одиночества и отчаяния и покончил с собой. Я даже не узнал, кончилась ли война.
if count_7.2=1 or count_7.16=1 then pln Я умер, совсем немного не дожив до развязки этой истории. Я не узнал, кончилась ли война, и кто победил в ней. Моё имя не получило огласки, а история событий моей жизни осталась только в государственных архивах под грифом "Совершенно Секретно". Я был забыт.
pln
Pln Вот так закончился последний полёт Егора Станенко.
end



